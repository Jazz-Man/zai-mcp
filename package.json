{
	"bin": {
		"web-reader-mcp": "bin/web-reader-mcp"
	},
	"bugs": {
		"url": "https://github.com/Jazz-Man/web-reader-mcp/issues"
	},
	"dependencies": {
		"@effect/platform-bun": "4.0.0-beta.107",
		"effect": "4.0.0-beta.107"
	},
	"description": "Web Search and Web Reader MCP Server - A standalone executable for reading web content",
	"devDependencies": {
		"@effect/tsgo": "0.36.2",
		"@tsconfig/bun": "1.0.10",
		"@types/bun": "1.3.14"
	},
	"engines": {
		"bun": "^1.0.10",
		"node": ">=22"
	},
	"homepage": "https://github.com/Jazz-Man/web-reader-mcp#readme",
	"license": "MIT",
	"module": "src/index.ts",
	"name": "@jazz-man/web-reader-mcp",
	"packageManager": "bun@1.0.10",
	"peerDependencies": {
		"typescript": "7.0.2"
	},
	"private": false,
	"publishConfig": {
		"access": "public",
		"registry": "https://npm.pkg.github.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Jazz-Man/web-reader-mcp.git"
	},
	"scripts": {
		"build": "bun build --compile --target=bun-darwin-arm64 --minify --bytecode src/index.ts --outfile bin/web-reader-mcp",
		"dev": "bun run src/index.ts",
		"lint:check": "biome check",
		"lint:fix": "biome check --fix",
		"lsp:diagnostics": "effect-tsgo diagnostics --project=tsconfig.json",
		"lsp:prepare": "effect-tsgo patch",
		"typecheck": "bun tsc --noEmit"
	},
	"type": "module",
	"version": "1.0.0"
}
